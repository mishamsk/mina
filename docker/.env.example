# Copy this file to .env, keep it mode 0600, and edit every required value.
# Shell-exported values override this file when invoking Docker Compose.

# Match the numeric owner of the deployment's config and backup directories.
MINA_UID=1000
MINA_GID=1000

# Required only when Mina creates auth.toml for a fresh deployment.
MINA_INITIAL_ADMIN_EMAIL=replace-with-your-email
MINA_INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password

# Uncomment and replace this placeholder to encrypt database files and backups.
# Keep the assignment absent when deliberately choosing plaintext accounting state.
# MINA_DATABASE_ENCRYPTION_KEY=replace-with-a-generated-encryption-key
